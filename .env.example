# Copy to .env and fill in the two API keys. Everything else has a working default
# that matches docker-compose.yml.

# --- datastores (match docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=meridian-dev
POSTGRES_DSN=postgresql+psycopg://meridian:meridian-dev@localhost:5432/meridian

# --- LLM providers (both free tier, no card) ---
# LLM_PROVIDER is the primary; the other is used as an automatic fallback.
LLM_PROVIDER=groq                       # groq | google
GROQ_API_KEY=                           # https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GOOGLE_API_KEY=                         # https://aistudio.google.com/apikey
GOOGLE_MODEL=gemini-2.0-flash

# --- embeddings (local, no key, 384-dim) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- logging ---
LOG_LEVEL=INFO
